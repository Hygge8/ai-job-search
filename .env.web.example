################################################################################
# Bootstrap configuration
#
# After the first login, AI, Tavily, strict-mode, repair-count and login settings
# can be managed from the browser's "系统设置" page. Browser-saved values are
# stored server-side in web-data/app.sqlite3 and override these defaults at runtime.
################################################################################

# Optional bootstrap AI values. They may be replaced from the browser later.
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=gpt-4.1
OPENAI_VISION_MODEL_NAME=gpt-4.1
AI_TIMEOUT_SECONDS=180

# Complete /apply defaults.
STRICT_APPLY_MODE=true
APPLY_MAX_REPAIR_ATTEMPTS=3
REQUIRE_COMPANY_RESEARCH=false
TAVILY_API_KEY=

# Initial browser login. Change this before exposing the service to any network.
SERVER_PORT=8000
WEB_USERNAME=admin
WEB_PASSWORD=change-me-now

# Persistent local storage.
WEB_DATABASE_FILE=web-data/app.sqlite3
APPLY_ARTIFACT_ROOT=web-data/applications
