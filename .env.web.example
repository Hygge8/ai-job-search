################################################################################
# AI model (server-side only)
################################################################################

# OpenAI-compatible API key. Never commit the real value.
OPENAI_API_KEY=sk-...

# Leave empty to use the official OpenAI endpoint, or set an OpenAI-compatible URL.
# Examples:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_BASE_URL=

# Model exposed by the selected provider.
OPENAI_MODEL_NAME=gpt-4.1-mini

# Request timeout in seconds.
AI_TIMEOUT_SECONDS=120

################################################################################
# Web access
################################################################################

SERVER_PORT=8000
WEB_USERNAME=admin
WEB_PASSWORD=change-me-now

################################################################################
# Persistence
################################################################################

WEB_DATABASE_FILE=web-data/app.sqlite3
