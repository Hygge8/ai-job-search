################################################################################
# AI model (server-side only)
################################################################################
OPENAI_API_KEY=replace-me
# Blank uses the provider default; compatible providers may set their URL.
OPENAI_BASE_URL=
# Text model used for parsing, evaluation, drafting, reviewing, revision and checks.
OPENAI_MODEL_NAME=gpt-4.1
# Vision-capable model used to inspect rendered PDF pages. It may equal the text model.
OPENAI_VISION_MODEL_NAME=gpt-4.1
AI_TIMEOUT_SECONDS=180

################################################################################
# Exact /apply behavior
################################################################################
# true: missing TeX/Poppler/vision checks fail the task instead of silently skipping.
STRICT_APPLY_MODE=true
# Maximum compile/layout repair cycles.
APPLY_MAX_REPAIR_ATTEMPTS=3
# Optional company research. Set true only after configuring the research key.
REQUIRE_COMPANY_RESEARCH=false
TAVILY_API_KEY=

################################################################################
# Web access
################################################################################
SERVER_PORT=8000
WEB_USERNAME=admin
WEB_PASSWORD=change-me-now

################################################################################
# Persistence
################################################################################
WEB_DATABASE_FILE=web-data/app.sqlite3
APPLY_ARTIFACT_ROOT=web-data/applications
